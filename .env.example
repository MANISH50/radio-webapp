# Copy to .env and fill in. Never commit .env.

# development | production | test
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Exact origins allowed to call /api (comma separated, no trailing slash).
# The first https:// entry is also the canonical origin for HTTP->HTTPS redirects.
ALLOWED_ORIGINS=https://radio.example.com

# HMAC key for session tokens and CSRF tokens. REQUIRED in production, >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Number of reverse-proxy hops in front of the app (for client IP and HTTPS detection).
TRUST_PROXY=1

# Optional: shared rate-limit counters (sliding window). Empty = in-memory.
REDIS_URL=redis://redis:6379

# Optional: fixed Radio Browser mirrors instead of DNS discovery (must match the allowlist).
RB_MIRRORS=
# Upstream host allowlist; entries starting with "." are suffix matches.
UPSTREAM_ALLOWED_HOSTS=.api.radio-browser.info

# Serve stations that only stream over plain HTTP (mixed content on HTTPS sites).
# Default: false in production, true otherwise.
INCLUDE_HTTP_STREAMS=false

# Per-minute limits (sliding window).
RATE_READ_PER_MIN=60
RATE_READ_IP_PER_MIN=120
RATE_CLICK_PER_MIN=10
RATE_CLICK_IP_PER_MIN=20
RATE_SESSION_IP_PER_MIN=20

LOG_LEVEL=info
